{
  "uid": "bee-manager",
  "title": "Bee manager",
  "tags": [
    "swarm",
    "bee",
    "postage"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "editable": true,
  "description": "bee-manager: Bee node wallet, postage batches, top-up/dilute actions and uploads. Metrics from bee-manager's /metrics (METRICS_PORT); action log from its stdout via Loki.",
  "templating": {
    "list": [
      {
        "name": "ds_prometheus",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1
      },
      {
        "name": "ds_loki",
        "label": "Loki",
        "type": "datasource",
        "query": "loki",
        "current": {},
        "hide": 0,
        "refresh": 1
      },
      {
        "name": "logs",
        "label": "Log stream",
        "type": "textbox",
        "query": "{container_name=~\".*bee-manager.*\"}",
        "current": {
          "text": "{container_name=~\".*bee-manager.*\"}",
          "value": "{container_name=~\".*bee-manager.*\"}"
        },
        "hide": 0,
        "description": "Loki stream selector for bee-manager's container."
      },
      {
        "name": "status",
        "label": "Status",
        "type": "custom",
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "query": "failed,blocked,confirmed,submitted,awaiting-topup,dry-run",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "hide": 0,
        "options": [
          {
            "text": "All",
            "value": "$__all",
            "selected": true
          },
          {
            "text": "failed",
            "value": "failed",
            "selected": false
          },
          {
            "text": "blocked",
            "value": "blocked",
            "selected": false
          },
          {
            "text": "confirmed",
            "value": "confirmed",
            "selected": false
          },
          {
            "text": "submitted",
            "value": "submitted",
            "selected": false
          },
          {
            "text": "awaiting-topup",
            "value": "awaiting-topup",
            "selected": false
          },
          {
            "text": "dry-run",
            "value": "dry-run",
            "selected": false
          }
        ]
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Node & wallet",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Poll",
      "description": "Last poll of the Bee node.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prometheus}"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 3,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prometheus}"
          },
          "expr": "max(beemgr_poll_ok)",
          "refId": "A",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "decimals": 0,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "FAILING"
                },
                "1": {
                  "text": "OK"
                }
              }
            }
          ]
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Last poll",
      "description": "",
