    {
      "id": 11,
      "type": "table",
      "title": "Batches",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prometheus}"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prometheus}"
          },
          "expr": "sum by (batch, label) (beemgr_batch_depth)",
          "refId": "A",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prometheus}"
          },
          "expr": "sum by (batch, label) (beemgr_batch_ttl_seconds) / 86400",
          "refId": "B",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prometheus}"
          },
          "expr": "sum by (batch, label) (beemgr_batch_utilization_ratio)",
          "refId": "C",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prometheus}"
          },
          "expr": "sum by (batch, label) (beemgr_batch_usable)",
          "refId": "D",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prometheus}"
          },
          "expr": "sum by (batch, label) (beemgr_batch_immutable)",
          "refId": "E",
