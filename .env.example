# Bee node. Internal address once the node is off Traefik.
BEE_URL=http://bee:1633
BEE_TIMEOUT_MS=15000
# Writes are on-chain transactions; giving up early does not cancel them.
BEE_WRITE_TIMEOUT_MS=300000
POLL_INTERVAL_MS=300000
DB_PATH=/data/monitor.sqlite
PORT=3000

# --- spending. Both must be flipped before anything is ever bought. ---
AUTO_TOPUP_ENABLED=false
DRY_RUN=true

TOPUP_WHEN_TTL_BELOW_DAYS=14
TOPUP_TARGET_TTL_DAYS=60
DILUTE_ENABLED=true
DILUTE_WHEN_UTILIZATION_ABOVE=0.8

# --- caps. These bound the blast radius; keep them tight. ---
MAX_TOPUP_BZZ_PER_BATCH=10
MAX_TOPUP_BZZ_PER_DAY=25
MIN_WALLET_BZZ=5
MIN_WALLET_XDAI=0.5

# Batches labelled with this prefix are never renewed (fire-and-forget).
UNMANAGED_LABEL_PREFIX=tmp-

WEBHOOK_URL=
ALERT_COOLDOWN_MS=21600000
WALLET_LOW_RUNWAY_DAYS=30

# Required. Without it the admin API and node passthrough are DISABLED (503),
# not open. Prefer ADMIN_TOKEN_FILE (a swarm secret) in production.
ADMIN_TOKEN=
# ADMIN_TOKEN_FILE=/run/secrets/ssm_admin_token
